# Copy this file to .env and edit the values for your deployment.
#
#   cp .env.example .env
#
# These values are used ONLY for generating local reverse-proxy configuration
# and installation documentation. They are never passed into the Docker image,
# never embedded in the frontend JavaScript or HTML, and never sent to the
# browser. The static frontend does not know its own domain.
#
# seerr.example.com is a reserved documentation example. Replace it with your
# own hostname before running scripts/configure.sh.

# Public HTTPS hostname where Seerr and Accessible Seerr are reachable.
# No protocol, no path, no port, no trailing slash.
PUBLIC_DOMAIN=seerr.example.com

# URL path where the accessible frontend will be served, relative to
# PUBLIC_DOMAIN. Must start with a slash and must not be just "/".
ACCESSIBLE_PATH=/accessible

# Name of the existing Docker network shared with your Seerr container.
DOCKER_NETWORK=media

# Name of the existing Seerr container or service on that Docker network.
SEERR_CONTAINER=seerr

# Internal port Seerr listens on inside the Docker network.
SEERR_PORT=5055
